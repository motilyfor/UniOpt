if (target_os == "") {
  target_os = host_os
}
if (target_cpu == "") {
  target_cpu = host_cpu
}
if (current_os == "") {
  current_os = target_os
}
if (current_cpu == "") {
  current_cpu = target_cpu
}

declare_args() {
  is_debug = true
  is_clang = false
  enable_gc_sections = false
}

is_linux = host_os == "linux" && current_os == "linux" && target_os == "linux"
is_win = host_os == "win" && current_os == "win" && target_os == "win"

is_x64 = current_cpu == "x64"
is_arm64 = current_cpu == "arm64"


if (is_linux) {
  if (target_cpu == "arm64") {
    set_default_toolchain("//build/toolchain/linux:gcc_arm64")
  } else if (is_clang) {
    set_default_toolchain("//build/toolchain/linux:clang")
  } else {
    set_default_toolchain("//build/toolchain/linux:gcc")
  }
} else if (is_win) {
  set_default_toolchain("//build/toolchain/win:msvc")
}


# Default configs
_shared_binary_target_configs = [
  "//build/config:compiler_defaults",
]

if (enable_gc_sections) {
  _shared_binary_target_configs += [ "//build/config:gc_sections_compile" ]
}

if (is_debug) {
  _shared_binary_target_configs += [ "//build/config:debug" ]
} else {
  _shared_binary_target_configs += [ "//build/config:release" ]
}

set_defaults("executable") {
  configs = _shared_binary_target_configs
  if (enable_gc_sections) {
    configs += [ "//build/config:gc_sections_link" ]
  }
}

set_defaults("static_library") {
  configs = _shared_binary_target_configs
}

set_defaults("shared_library") {
  configs = _shared_binary_target_configs
  if (enable_gc_sections) {
    configs += [ "//build/config:gc_sections_link" ]
  }
}

set_defaults("source_set") {
  configs = _shared_binary_target_configs
}
